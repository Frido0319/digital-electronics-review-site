      ],
      "knowledge_ids": [
        "rectifier_bridge"
      ],
      "source_pages": [
        {
          "file": "第5章-直流稳压电源.pdf",
          "page": 9,
          "image_path": "assets/course_pages/ch5_p009.png"
        }
      ],
      "subquestions": [
        {
          "id": "5.1.8(1)",
          "prompt": "求变压器二次电压有效值。",
          "answer": "U2 ≈ 122 V。",
          "solution_steps": [
            "桥式整流无滤波时 UO = 0.9U2。",
            "U2 = 110 / 0.9 ≈ 122 V。"
          ]
        },
        {
          "id": "5.1.8(2)",
          "prompt": "求二次电流有效值。",
          "answer": "I2 ≈ 2.22 A。",
          "solution_steps": [
            "负载电流 IO = 110 / 55 = 2 A。",
            "桥式整流中 I2 ≈ 1.11IO。",
            "I2 ≈ 2.22 A。"
          ]
        },
        {
          "id": "5.1.8(3)",
          "prompt": "选用二极管。",
          "answer": "二极管平均电流应大于 1 A，反向峰值电压应大于约 173 V，并留裕量。",
          "solution_steps": [
            "每只二极管平均电流约为 IO / 2 = 1 A。",
            "URM = √2U2 ≈ 173 V。",
            "实际选型应留额定裕量。"
          ]
        }
      ],
      "answer_source": "推导答案"
    },
